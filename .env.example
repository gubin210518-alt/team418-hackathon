# 이 파일을 복사해서 ".env" 로 저장한 뒤, 진짜 값을 채워요.
# .env 는 .gitignore 에 막혀 있어서 GitHub 에 올라가지 않아요.
# 이 .env.example 에는 진짜 키를 절대 적지 않아요.

# AI: OpenAI(ChatGPT) API 로 정함 (동아리 계정). 진짜 연결할 땐 openai
# 키가 없을 땐 mock (가짜 AI, 0원) 으로 개발해요
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# 서버 설정
PORT=8787
# NPC 응답 제한 시간(ms). 넘으면 미리 쓴 대본으로 전환
AI_TIMEOUT_MS=5000
# 하루 AI 호출 한도. 넘으면 mock 으로 자동 전환 (요금 폭탄 방지)
AI_DAILY_LIMIT=500
